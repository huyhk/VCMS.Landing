@model ChromeRenderViewModel
@using LandingCms.Services
@using LandingCms
@inject Microsoft.Extensions.Localization.IStringLocalizer<PublicResource> PublicText
@{
    var viewModel = Model.Page;
    viewModel.ExtendedSettings.TryGetValue("social.facebook_url", out var facebookUrl);
    viewModel.ExtendedSettings.TryGetValue("social.zalo_url", out var zaloUrl);
    var navigationIdAssigned = false;
    var hasHeaderNavigation = Model.Region == "header" && Model.Layout.Rows.SelectMany(x => x.Columns).SelectMany(x => x.Components).Any(x => x.Type == "navigation");
    var defaultLanguageCode = viewModel.Languages.FirstOrDefault(x => x.IsDefault)?.Code;
    string? ComponentText(ChromeComponent component)
    {
        if (component.Translations.TryGetValue(viewModel.CurrentLanguage.Code, out var currentText) && !string.IsNullOrWhiteSpace(currentText)) return currentText;
        if (defaultLanguageCode is not null && component.Translations.TryGetValue(defaultLanguageCode, out var defaultText) && !string.IsNullOrWhiteSpace(defaultText)) return defaultText;
        return component.Text;
    }
}
@foreach (var row in Model.Layout.Rows)
{
    <div class="chrome-row chrome-row-@row.Key chrome-bg-@row.Background chrome-height-@row.Height @(row.HideOnMobile ? "chrome-mobile-hidden" : null)">
        <div class="@(row.Container == "full" ? "chrome-container-full" : "container") chrome-columns">
            @foreach (var column in row.Columns)
            {
                <div class="chrome-column chrome-width-@column.Width chrome-align-@column.Align">
                    @foreach (var component in column.Components)
                    {
                        <div class="chrome-component chrome-component-@component.Type chrome-variant-@component.Variant @(component.HideOnMobile ? "chrome-mobile-hidden" : null)">
                        @switch (component.Type)
                        {
                            case "logo":
                                {
                                    var logoKey = component.Variant == "light" ? "branding.logo_light" : "branding.logo_primary";
                                    if (!viewModel.BrandingMedia.TryGetValue(logoKey, out var logo)) viewModel.BrandingMedia.TryGetValue("branding.logo_primary", out logo);
                                    <a class="brand" href="#top">
                                        @if (logo is not null)
                                        {
                                            var source = ResponsiveImageSources.Build(Url, logo, "thumbnail", 320);
                                            <img src="@source.Src" srcset="@source.SrcSet" sizes="190px" width="@logo.Width" height="@logo.Height" alt="@viewModel.Settings.SiteName" decoding="async">
                                        }
                                        else
                                        {
                                            @(viewModel.Settings.LogoText ?? viewModel.Settings.SiteName)
                                        }
                                    </a>
                                }
                                break;
                            case "navigation":
                                var navigationId = Model.Region == "header" && !navigationIdAssigned ? "site-navigation" : null;
                                navigationIdAssigned |= navigationId is not null;
                                <nav id="@navigationId">
                                    @foreach (var item in viewModel.NavigationItems)
                                    {
                                        <a href="#@item.SectionKey">@item.Label</a>
                                    }
                                </nav>
                                break;
                            case "button":
                                <a class="btn btn-small" href="@(component.Url ?? "#contact")">@(ComponentText(component) ?? PublicText["Header.Contact"].Value)</a>
                                break;
                            case "language":
                                if (viewModel.Languages.Count > 1)
                                {
                                    <div class="language-switcher" role="navigation" aria-label="@PublicText["Language.Navigation"]">
                                        @foreach (var language in viewModel.Languages)
                                        {
                                            var languageUrl = language.IsDefault ? "/" : $"/{language.Code}";
                                            <a href="@languageUrl" class="@(language.Code == viewModel.CurrentLanguage.Code ? "active" : null)">@language.Code.ToUpperInvariant()</a>
                                        }
                                    </div>
                                }
                                break;
                            case "phone":
                                if (!string.IsNullOrWhiteSpace(viewModel.Settings.Phone)) { <a href="tel:@viewModel.Settings.Phone">@viewModel.Settings.Phone</a> }
                                break;
                            case "email":
                                if (!string.IsNullOrWhiteSpace(viewModel.Settings.Email)) { <a href="mailto:@viewModel.Settings.Email">@viewModel.Settings.Email</a> }
                                break;
                            case "address":
                                if (!string.IsNullOrWhiteSpace(viewModel.Settings.Address)) { <span>@viewModel.Settings.Address</span> }
                                break;
                            case "company":
                                <p>@(ComponentText(component) ?? viewModel.Settings.CompanyName ?? viewModel.Settings.SiteName)</p>
                                break;
                            case "copyright":
                                <span>@(ComponentText(component) ?? viewModel.Settings.FooterText)</span>
                                break;
                            case "social":
                                if (!string.IsNullOrWhiteSpace(facebookUrl)) { <a href="@facebookUrl" target="_blank" rel="noopener">Facebook</a> }
                                if (!string.IsNullOrWhiteSpace(zaloUrl)) { <a href="@zaloUrl" target="_blank" rel="noopener">Zalo</a> }
                                break;
                            case "text":
                                <span>@ComponentText(component)</span>
                                break;
                        }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
@if (hasHeaderNavigation)
{
    <button class="menu-button chrome-menu-button" type="button" aria-label="Mở menu" aria-controls="site-navigation" aria-expanded="false">☰</button>
}
