 .template-conversion .hero{min-height:auto;padding:120px 0 65px}.template-conversion .hero-grid{grid-template-columns:1fr}.template-conversion .hero h1{font-size:clamp(42px,12vw,60px)}
 .template-conversion .section{padding:68px 0}.template-conversion .section-heading{text-align:left}
