@model HomeViewModel
@using LandingCms.Services
@using LandingCms
@inject Microsoft.Extensions.Localization.IStringLocalizer<PublicResource> PublicText
@{
    Model.ExtendedSettings.TryGetValue("analytics.ga_measurement_id", out var gaId);
}

@await Html.PartialAsync("~/Views/Home/Shared/_PublicHeader.cshtml", Model)

<main id="top">
    @foreach (var pageSection in Model.Sections)
    {
        var renderModel = new SectionRenderViewModel(pageSection, Model);
        switch (pageSection.SectionType)
        {
            case "Hero":
                @await Html.PartialAsync("~/Views/Home/Sections/_Hero.cshtml", renderModel)
                break;
            case "Cards":
                @await Html.PartialAsync("~/Views/Home/Sections/_Cards.cshtml", renderModel)
                break;
            case "Content":
                @await Html.PartialAsync("~/Views/Home/Sections/_Content.cshtml", renderModel)
                break;
            case "Stats":
                @await Html.PartialAsync("~/Views/Home/Sections/_Stats.cshtml", renderModel)
                break;
            case "Cta" when pageSection.SectionKey == "contact":
                @await Html.PartialAsync("~/Views/Home/Sections/_Contact.cshtml", renderModel)
                break;
            case "Cta":
                @await Html.PartialAsync("~/Views/Home/Sections/_Cta.cshtml", renderModel)
                break;
            case "Gallery":
                @await Html.PartialAsync("~/Views/Home/Sections/_Gallery.cshtml", renderModel)
                break;
            case "Faq":
                @await Html.PartialAsync("~/Views/Home/Sections/_Faq.cshtml", renderModel)
                break;
            case "Testimonials":
                @await Html.PartialAsync("~/Views/Home/Sections/_Testimonials.cshtml", renderModel)
                break;
            case "Process":
                @await Html.PartialAsync("~/Views/Home/Sections/_Process.cshtml", renderModel)
                break;
            case "Media":
                @await Html.PartialAsync("~/Views/Home/Sections/_Media.cshtml", renderModel)
                break;
            case "Pricing":
                @await Html.PartialAsync("~/Views/Home/Sections/_Pricing.cshtml", renderModel)
                break;
            case "Partners":
                @await Html.PartialAsync("~/Views/Home/Sections/_Partners.cshtml", renderModel)
                break;
            case "Team":
                @await Html.PartialAsync("~/Views/Home/Sections/_Team.cshtml", renderModel)
                break;
        }
    }
</main>

@await Html.PartialAsync("~/Views/Home/Shared/_PublicFooter.cshtml", Model)

@if (!string.IsNullOrWhiteSpace(gaId))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '@gaId');
    </script>
}
