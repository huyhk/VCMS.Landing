/* Conversion template: compact hierarchy, repeated proof and prominent actions. */
.template-conversion { color:var(--ink); background:var(--page-bg); }
.template-conversion .container { width:min(1080px,calc(100% - 40px)); }
.template-conversion .site-header { color:var(--header-text); background:var(--header-bg); border-bottom-color:var(--line); box-shadow:var(--theme-shadow); }
.template-conversion .nav { height:70px; }
.template-conversion .nav nav { gap:22px; }
.template-conversion .btn { border-radius:var(--radius-button); box-shadow:none; }
.template-conversion .hero { min-height:720px; display:grid; align-items:center; padding:130px 0 70px; color:var(--hero-text); background:linear-gradient(150deg,var(--hero-bg),var(--page-bg) 52%,var(--highlight)); }
.template-conversion .hero-grid { grid-template-columns:1.08fr .92fr; gap:55px; }
.template-conversion .hero h1 { font-size:clamp(44px,5.4vw,68px); line-height:1.02; }
.template-conversion .lead { margin:22px 0 28px; font-size:17px; line-height:1.65; }
.template-conversion .hero-art { min-height:390px; }
.template-conversion .art-card { width:340px; height:260px; border-radius:var(--radius-card); transform:none; }
.template-conversion .mini-card { bottom:30px; color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-card); box-shadow:var(--theme-shadow); }
.template-conversion .hero-lead-form { color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-card); box-shadow:var(--theme-shadow); }
.template-conversion .section { padding:82px 0; }
.template-conversion .section-heading { max-width:720px; margin:0 auto 42px; text-align:center; }
.template-conversion .section h2,.template-conversion .stats h2 { font-size:clamp(34px,4vw,48px); }
.template-conversion .card-grid { gap:16px; }
.template-conversion .service-card { min-height:245px; padding:25px; border-radius:var(--radius-card); background:var(--surface); }
.template-conversion .service-card h3 { margin-top:42px; }
.template-conversion .service-card:hover { transform:translateY(-3px); box-shadow:var(--theme-shadow); }
.template-conversion .content-section .split { gap:65px; }
.template-conversion .image-wrap img { border-radius:var(--radius-card); }
.template-conversion .image-badge { border-radius:var(--radius-card); }
.template-conversion .stats { padding:64px 0; color:var(--contrast-text); background:var(--contrast-bg); }
.template-conversion .stats h2 { margin-bottom:34px; }
.template-conversion .stats-grid strong { font-size:36px; }
.template-conversion .stats-grid span { color:color-mix(in srgb,var(--contrast-text) 80%,transparent); }
.template-conversion .testimonial-card,.template-conversion .media-card,.template-conversion .pricing-card,.template-conversion .team-card { border-radius:var(--radius-card); box-shadow:var(--theme-shadow); }
.template-conversion .testimonial-card { min-height:230px; }
.template-conversion .gallery-item { border-radius:var(--radius-card); }
.template-conversion .process-list { gap:14px; }
.template-conversion .process-list article { border:1px solid var(--line); border-radius:var(--radius-card); }
.template-conversion .process-list article:last-child { border-right:1px solid var(--line); }
.template-conversion .pricing-card.featured { transform:translateY(-10px); }
.template-conversion .partners-section { padding-block:55px; }
.template-conversion .partner-logo { min-height:105px; border-radius:var(--radius-card); }
.template-conversion .faq-list details { border-radius:var(--radius-card); }
.template-conversion .cta { padding:68px 40px; border-radius:var(--radius-card); box-shadow:0 24px 60px color-mix(in srgb,var(--brand) 18%,transparent); }
.template-conversion .contact-section { background:linear-gradient(145deg,var(--surface-alt),var(--page-bg)); }
.template-conversion .contact-grid { gap:60px; }
.template-conversion .contact-form { border-radius:var(--radius-card); box-shadow:var(--theme-shadow); }
.template-conversion footer { padding:48px 0; }
@media(max-width:800px){
 .template-conversion .nav{height:66px}.template-conversion .nav nav.open{top:66px}
