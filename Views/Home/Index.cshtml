.faq-list summary span { color: var(--brand); font-size: 26px; line-height: 1; transition: transform .2s ease; }
.faq-list details[open] summary span { transform: rotate(45deg); }
.faq-answer { padding: 0 22px 22px; color: var(--muted); }
.faq-answer > :first-child { margin-top: 0; }
.faq-answer > :last-child { margin-bottom: 0; }

.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.testimonial-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(16, 24, 40, .06);
}

.testimonials-section.featured .testimonial-card:first-child { grid-column: span 2; }
.testimonial-quote { margin: 0 0 32px; font-size: 20px; line-height: 1.65; }
.testimonial-person { display: flex; align-items: center; gap: 13px; }
.testimonial-person img { width: 52px; height: 52px; object-fit: cover; border-radius: 50%; }
.testimonial-person strong,.testimonial-person span { display: block; }
.testimonial-person span { margin-top: 3px; color: var(--muted); font-size: 13px; }

.process-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
}

.process-list article {
    position: relative;
    padding: 28px;
    border-left: 1px solid var(--line);
}

.process-list article:last-child { border-right: 1px solid var(--line); }
.process-number { display: block; margin-bottom: 34px; color: var(--brand); font-size: 14px; font-weight: 800; letter-spacing: .12em; }
.process-list h3 { margin: 0 0 12px; font-size: 21px; }
.process-list p { margin: 0; color: var(--muted); line-height: 1.7; }
.process-section.vertical .process-list { max-width: 820px; margin: 0 auto; grid-template-columns: 1fr; }
.process-section.vertical .process-list article { display: grid; grid-template-columns: 72px 1fr; column-gap: 20px; border-right: 0; border-bottom: 1px solid var(--line); }
.process-section.vertical .process-number { grid-row: span 2; margin: 4px 0 0; }

.media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
}

.media-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(16, 24, 40, .06);
}

.media-section.featured .media-card:first-child { grid-column: 1 / -1; }
.media-player,.media-card iframe {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: #111827;
}

.media-player { cursor: pointer; }
.media-player img,.media-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
.media-placeholder { background: radial-gradient(circle at 30% 25%, #334155, #0f172a 68%); }
.media-player::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.28)); transition: background .2s ease; }
.media-player:hover::after { background: rgba(0,0,0,.12); }
.media-play {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: grid;
    width: 66px;
    height: 66px;
    place-items: center;
    padding-left: 4px;
    border-radius: 50%;
    color: #111827;
    background: rgba(255,255,255,.94);
    box-shadow: 0 12px 35px rgba(0,0,0,.24);
    transform: translate(-50%,-50%);
}

.media-copy { padding: 22px 24px 25px; }
.media-copy h3 { margin: 0; font-size: 21px; }
.media-copy p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
}

.pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #fff;
}

.pricing-card.featured { border-color: var(--brand); box-shadow: 0 24px 60px color-mix(in srgb,var(--brand) 16%,transparent); }
.pricing-badge { position: absolute; top: 18px; right: 18px; padding: 6px 10px; border-radius: 999px; color: var(--brand); background: color-mix(in srgb,var(--brand) 10%,#fff); font-size: 11px; font-weight: 800; }
.pricing-card h3 { margin: 0 0 10px; padding-right: 62px; font-size: 21px; }
.pricing-description { min-height: 48px; margin: 0 0 24px; color: var(--muted); line-height: 1.6; }
.pricing-price { display: flex; align-items: baseline; gap: 8px; margin-bottom: 24px; }
.pricing-price strong { font-size: clamp(34px,4vw,48px); letter-spacing: -.04em; }
.pricing-price span { color: var(--muted); font-size: 13px; }
.pricing-features { flex: 1; margin-bottom: 28px; color: var(--muted); }
.pricing-features ul { padding-left: 20px; }
.pricing-features li { margin-bottom: 10px; }
.pricing-card .btn { width: 100%; }
.pricing-button-secondary { color: var(--ink); background: #fff; border: 1px solid var(--line); box-shadow: none; }
.pricing-section.compact .pricing-card { padding: 25px; }

.partners-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
}

.partner-logo {
    display: grid;
    min-height: 130px;
    place-items: center;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    transition: border-color .2s ease,transform .2s ease;
}

a.partner-logo:hover { border-color: var(--brand); transform: translateY(-3px); }
.partner-logo img { display: block; width: 100%; max-width: 180px; height: 78px; object-fit: contain; }
.partners-section.monochrome .partner-logo img { filter: grayscale(1); opacity: .68; transition: filter .2s ease,opacity .2s ease; }
.partners-section.monochrome .partner-logo:hover img { filter: none; opacity: 1; }

.team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.team-card { overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: #fff; }
.team-card > img { display: block; width: 100%; aspect-ratio: .9; object-fit: cover; background: var(--soft); }
.team-copy { padding: 20px; }
.team-copy h3 { margin: 0; font-size: 19px; }
.team-copy h3 a:hover { color: var(--brand); }
.team-copy > strong { display: block; margin-top: 6px; color: var(--brand); font-size: 12px; }
.team-copy p { margin: 13px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
.team-section.compact .team-card { display: grid; grid-template-columns: 110px 1fr; }
.team-section.compact .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.team-section.compact .team-card > img { height: 100%; aspect-ratio: auto; }

@media (max-width: 800px) {
    .hero-lead-form { padding: 20px; }
    .gallery-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .gallery-item img { height: 180px; }
    .gallery-section.featured .gallery-item:first-child { grid-column: span 2; grid-row: auto; }
    .gallery-section.featured .gallery-item:first-child img { height: 300px; }
    .gallery-lightbox { padding: 60px 12px 24px; }
    .gallery-lightbox figure img { max-height: calc(100vh - 110px); }
    .gallery-lightbox-nav { width: 42px; height: 42px; background: rgba(0,0,0,.48); }
    .gallery-lightbox-nav.previous { left: 8px; }
    .gallery-lightbox-nav.next { right: 8px; }
    .gallery-lightbox-close { top: 10px; right: 10px; }
    .faq-section.two-columns .faq-list,.testimonial-grid,.process-list { grid-template-columns: 1fr; }
    .testimonials-section.featured .testimonial-card:first-child { grid-column: auto; }
    .testimonial-card { min-height: 0; padding: 22px; }
    .process-list article,.process-list article:last-child { border-right: 0; border-bottom: 1px solid var(--line); }
    .process-section.vertical .process-list article { grid-template-columns: 54px 1fr; padding-inline: 12px; }
    .media-grid { grid-template-columns: 1fr; }
    .media-section.featured .media-card:first-child { grid-column: auto; }
    .media-play { width: 54px; height: 54px; }
    .pricing-grid,.team-grid { grid-template-columns: 1fr; }
    .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pricing-description { min-height: 0; }
    .team-section.compact .team-card { grid-template-columns: 90px 1fr; }
    .team-section.compact .team-grid { grid-template-columns: 1fr; }
}


