@model HomeViewModel
@{
    Model.ExtendedSettings.TryGetValue("social.facebook_url", out var facebookUrl);
    Model.ExtendedSettings.TryGetValue("social.zalo_url", out var zaloUrl);
    Model.ExtendedSettings.TryGetValue("analytics.ga_measurement_id", out var gaId);
}

<style>:root { --brand: @Model.Settings.PrimaryColor }</style>

<header class="site-header">
    <div class="container nav">
        <a class="brand" href="#top">
            @if (Model.BrandingMedia.TryGetValue("branding.logo_primary", out var logo))
            {
                <img src="@logo.RelativeUrl" width="@logo.Width" height="@logo.Height" alt="@Model.Settings.SiteName">
            }
            else
            {
                @(Model.Settings.LogoText ?? Model.Settings.SiteName)
            }
        </a>
        <nav id="site-navigation">
            @foreach (var item in Model.NavigationItems)
            {
                <a href="#@item.SectionKey">@item.Label</a>
            }
        </nav>
        <a class="btn btn-small" href="#contact">Trao đổi dự án</a>
        <button class="menu-button" type="button" aria-label="Mở menu" aria-controls="site-navigation" aria-expanded="false">☰</button>
    </div>
</header>

<main id="top">
    @foreach (var section in Model.Sections)
    {
        var renderModel = new SectionRenderViewModel(section, Model);
        switch (section.SectionType)
        {
            case "Hero":
                @await Html.PartialAsync("~/Views/Home/Sections/_Hero.cshtml", renderModel)
                break;
            case "Cards":
                @await Html.PartialAsync("~/Views/Home/Sections/_Cards.cshtml", renderModel)
                break;
            case "Content":
                @await Html.PartialAsync("~/Views/Home/Sections/_Content.cshtml", renderModel)
                break;
            case "Stats":
                @await Html.PartialAsync("~/Views/Home/Sections/_Stats.cshtml", renderModel)
                break;
            case "Cta" when section.SectionKey == "contact":
                @await Html.PartialAsync("~/Views/Home/Sections/_Contact.cshtml", renderModel)
                break;
            case "Cta":
                @await Html.PartialAsync("~/Views/Home/Sections/_Cta.cshtml", renderModel)
                break;
        }
    }
</main>

<footer>
    <div class="container footer-grid">
        <div>
            <a class="brand" href="#top">@(Model.Settings.LogoText ?? Model.Settings.SiteName)</a>
            <p>@Model.Settings.FooterText</p>
            @if (!string.IsNullOrWhiteSpace(facebookUrl))
            {
                <a href="@facebookUrl" target="_blank" rel="noopener noreferrer">Facebook</a>
            }
            @if (!string.IsNullOrWhiteSpace(zaloUrl))
            {
                <a href="@zaloUrl" target="_blank" rel="noopener noreferrer">Zalo</a>
            }
        </div>
        <div>
            <strong>Liên hệ</strong>
            <a href="mailto:@Model.Settings.Email">@Model.Settings.Email</a>
            <a href="tel:@Model.Settings.Phone">@Model.Settings.Phone</a>
            <span>@Model.Settings.Address</span>
        </div>
        <a class="admin-link" href="/admin">Quản trị</a>
    </div>
</footer>

@if (!string.IsNullOrWhiteSpace(gaId))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '@gaId');
    </script>
}
