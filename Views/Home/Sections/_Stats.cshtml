@model SectionRenderViewModel
@{
    var contentSection = Model.Section;
    var lines = (contentSection.Content ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries);
}

<section id="@contentSection.SectionKey" class="stats">
    <div class="container">
        <h2>@contentSection.Title</h2>
        <div class="stats-grid">
            @foreach (var line in lines)
            {
                var parts = line.Split('|', 2);
                <div>
                    <strong>@parts[0]</strong>
                    <span>@(parts.Length > 1 ? parts[1] : "")</span>
                </div>
            }
        </div>
    </div>
</section>
