@model SectionRenderViewModel
@{
    var section = Model.Section;
    Model.Page.SectionMedia.TryGetValue(section.SectionKey, out var heroMedia);
    var backgrounds = heroMedia?.Where(x => x.Role == "Background").ToList() ?? new List<SectionMedia>();
}

<section id="@section.SectionKey" class="hero @(backgrounds.Count > 0 ? "has-background" : "")">
    @if (backgrounds.Count > 0)
    {
        <div class="hero-backgrounds">
            @for (var index = 0; index < backgrounds.Count; index++)
            {
                var background = backgrounds[index];
                <img class="@(index == 0 ? "active" : "")"
                     src="@background.MediaAsset.RelativeUrl"
                     style="object-position:@background.FocalPointX% @background.FocalPointY%"
                     alt=""
                     aria-hidden="true"
                     loading="@(index == 0 ? "eager" : "lazy")">
            }
        </div>
    }
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="container hero-grid">
        <div>
            <p class="eyebrow">@section.Eyebrow</p>
            <h1>@section.Title</h1>
            <p class="lead">@section.Subtitle</p>
            <div class="actions">
                <a class="btn" href="@section.PrimaryButtonUrl">@section.PrimaryButtonText <span>→</span></a>
                <a class="text-link" href="@section.SecondaryButtonUrl">@section.SecondaryButtonText</a>
            </div>
        </div>
        <div class="hero-art">
            <div class="art-card">
                <span class="art-label">Tăng trưởng bền vững</span>
                <strong>+42%</strong>
                <div class="chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="mini-card">✦ <span>Thiết kế có mục tiêu</span></div>
        </div>
    </div>
</section>
