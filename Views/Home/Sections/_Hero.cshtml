@model SectionRenderViewModel
@using LandingCms.Services
@{
    var contentSection = Model.Section;
    Model.Page.SectionMedia.TryGetValue(contentSection.SectionKey, out var heroMedia);
    var backgrounds = heroMedia?.Where(x => x.Role == "Background").ToList() ?? new List<SectionMedia>();
}

<section id="@contentSection.SectionKey" class="hero @(backgrounds.Count > 0 ? "has-background" : "")">
    @if (backgrounds.Count > 0)
    {
        <div class="hero-backgrounds">
            @for (var index = 0; index < backgrounds.Count; index++)
            {
                var background = backgrounds[index];
                var imageSource = ResponsiveImageSources.Build(Url, background.MediaAsset, "hero", 1280);
                if (index == 0)
                {
                    <img class="active"
                         src="@imageSource.Src"
                         srcset="@imageSource.SrcSet"
                         sizes="100vw"
                         style="object-position:@background.FocalPointX% @background.FocalPointY%"
                         alt="" aria-hidden="true" loading="eager" fetchpriority="high">
                }
                else
                {
                    <img data-src="@imageSource.Src"
                         data-srcset="@imageSource.SrcSet"
                         data-sizes="100vw"
                         style="object-position:@background.FocalPointX% @background.FocalPointY%"
                         alt="" aria-hidden="true" loading="lazy">
                }
            }
        </div>
    }
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="container hero-grid @contentSection.LayoutVariant">
        <div>
            <p class="eyebrow">@contentSection.Eyebrow</p>
            <h1>@contentSection.Title</h1>
            <p class="lead">@contentSection.Subtitle</p>
            <div class="actions">
                <a class="btn" href="@contentSection.PrimaryButtonUrl">@contentSection.PrimaryButtonText <span>→</span></a>
                <a class="text-link" href="@contentSection.SecondaryButtonUrl">@contentSection.SecondaryButtonText</a>
            </div>
        </div>
        @if (contentSection.LayoutVariant == "lead-form-right")
        {
            <div class="hero-lead-form">
                @await Html.PartialAsync("~/Views/Home/Sections/_ContactForm.cshtml", Model.Page)
            </div>
        }
        else
        {
        <div class="hero-art">
            <div class="art-card">
                <span class="art-label">Tăng trưởng bền vững</span>
                <strong>+42%</strong>
                <div class="chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="mini-card">✦ <span>Thiết kế có mục tiêu</span></div>
        </div>
        }
    </div>
</section>
