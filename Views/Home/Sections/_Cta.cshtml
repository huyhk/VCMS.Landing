@model SectionRenderViewModel
@{
    var contentSection = Model.Section;
}

<section id="@contentSection.SectionKey" class="section">
    <div class="container cta">
        <p class="eyebrow">@contentSection.Eyebrow</p>
        <h2>@contentSection.Title</h2>
        <p>@contentSection.Subtitle</p>
        <a class="btn btn-light" href="@contentSection.PrimaryButtonUrl">@contentSection.PrimaryButtonText →</a>
    </div>
</section>
