@model SectionRenderViewModel
@{
    var section = Model.Section;
}

<section id="@section.SectionKey" class="section section-soft content-section @section.LayoutVariant">
    <div class="container split">
        <div class="image-wrap">
            <img src="@section.ImageUrl" alt="@section.Title" loading="lazy">
            <div class="image-badge"><strong>8+</strong><span>năm kinh nghiệm</span></div>
        </div>
        <div class="content-wrap">
            <p class="eyebrow">@section.Eyebrow</p>
            <h2>@section.Title</h2>
            <div class="body-copy rich-content">
                @if (section.ContentIsHtml)
                {
                    @Html.Raw(section.Content)
                }
                else
                {
                    @section.Content
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(section.PrimaryButtonText) && !string.IsNullOrWhiteSpace(section.PrimaryButtonUrl))
            {
                <a class="btn" href="@section.PrimaryButtonUrl">@section.PrimaryButtonText →</a>
            }
            @if (!string.IsNullOrWhiteSpace(section.SecondaryButtonText) && !string.IsNullOrWhiteSpace(section.SecondaryButtonUrl))
            {
                <a class="text-link" href="@section.SecondaryButtonUrl">@section.SecondaryButtonText →</a>
            }
        </div>
    </div>
</section>
