@model SectionRenderViewModel
@{
    var contentSection = Model.Section;
    Model.Page.SectionMedia.TryGetValue(contentSection.SectionKey, out var sectionMedia);
    var images = sectionMedia?.Where(x => x.Role == "Gallery").ToList() ?? new List<SectionMedia>();
}
<section id="@contentSection.SectionKey" class="section gallery-section @contentSection.LayoutVariant">
    <div class="container">
        <div class="section-heading"><p class="eyebrow">@contentSection.Eyebrow</p><h2>@contentSection.Title</h2><p>@contentSection.Subtitle</p></div>
        @if (images.Count > 0)
        {
            <div class="gallery-grid">
                @foreach (var image in images)
                {
                    <a href="@image.MediaAsset.RelativeUrl" target="_blank" rel="noopener" class="gallery-item"><img src="@image.MediaAsset.RelativeUrl" width="@image.MediaAsset.Width" height="@image.MediaAsset.Height" alt="@contentSection.Title" loading="lazy"></a>
                }
            </div>
        }
    </div>
</section>
