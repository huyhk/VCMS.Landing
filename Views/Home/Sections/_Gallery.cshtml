@model SectionRenderViewModel
@using LandingCms.Services
@{
    var contentSection = Model.Section;
    Model.Page.SectionMedia.TryGetValue(contentSection.SectionKey, out var sectionMedia);
    var images = sectionMedia?.Where(x => x.Role == "Gallery").ToList() ?? new List<SectionMedia>();
}
<section id="@contentSection.SectionKey" class="section gallery-section @contentSection.LayoutVariant">
    <div class="container">
        <div class="section-heading"><p class="eyebrow">@contentSection.Eyebrow</p><h2>@contentSection.Title</h2><p>@contentSection.Subtitle</p></div>
        @if (images.Count > 0)
        {
            <div class="gallery-grid">
                @foreach (var image in images)
                {
                    var imageSource = ResponsiveImageSources.Build(Url, image.MediaAsset, "thumbnail", 800);
                    <a href="@image.MediaAsset.RelativeUrl"
                       class="gallery-item"
                       data-gallery-item
                       data-gallery-group="@contentSection.SectionKey"
                       aria-label="Phóng to hình ảnh">
                        <img src="@imageSource.Src" srcset="@imageSource.SrcSet"
                             sizes="(max-width: 800px) 100vw, (max-width: 1200px) 50vw, 33vw"
                             width="@image.MediaAsset.Width" height="@image.MediaAsset.Height"
                             alt="@contentSection.Title" loading="lazy" decoding="async">
                    </a>
                }
            </div>
        }
    </div>
</section>
