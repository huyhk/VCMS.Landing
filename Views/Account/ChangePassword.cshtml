@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<main class="auth-page"><form asp-action="ChangePassword" method="post" class="auth-card"><a class="brand" href="/admin">LandingCMS</a><h1>Đổi mật khẩu</h1><p>Mật khẩu mới tối thiểu 10 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</p><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" autocomplete="current-password"><span asp-validation-for="CurrentPassword"></span><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" autocomplete="new-password"><span asp-validation-for="NewPassword"></span><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" autocomplete="new-password"><span asp-validation-for="ConfirmPassword"></span><button class="btn" type="submit">Đổi mật khẩu</button><a href="/admin">← Quay lại quản trị</a></form></main>
