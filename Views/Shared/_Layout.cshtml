<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @if (ViewData["Description"] is string description && !string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    @if (ViewData["Keywords"] is string keywords && !string.IsNullOrWhiteSpace(keywords))
    {
        <meta name="keywords" content="@keywords" />
    }
    @if (ViewData["FaviconUrl"] is string faviconUrl) { <link rel="icon" href="@faviconUrl" /> }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-navigation.css" asp-append-version="true" />
    @if (ViewData["HasHeroLeadForm"] is true)
    {
        <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/enhanced-sections.css" asp-append-version="true" />
    }
    else
    {
        <link rel="preload" as="style" href="~/css/contact.css" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'" />
        <link rel="preload" as="style" href="~/css/enhanced-sections.css" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'" />
    }
    <link rel="preload" as="style" href="~/css/rich-content.css" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" as="style" href="~/css/content-variants.css" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
        <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/rich-content.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/content-variants.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/enhanced-sections.css" asp-append-version="true" />
    </noscript>
    @if (ViewData["TemplateStylesheet"] is string templateStylesheet &&
         templateStylesheet.StartsWith("~/css/templates/", StringComparison.Ordinal))
    {
        <link rel="stylesheet" href="@templateStylesheet" asp-append-version="true" />
    }
</head>
<body>@RenderBody()<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body>
</html>
