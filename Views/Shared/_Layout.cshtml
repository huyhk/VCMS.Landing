@inject LandingCms.Services.ITemplateStyleProvider TemplateStyleProvider
@{
    var templateStylesheet = ViewData["TemplateStylesheet"] as string;
    var inlineTemplateCss = templateStylesheet is null
        ? null
        : TemplateStyleProvider.GetInlineCss(templateStylesheet);
    var bodyClass = ViewData["BodyClass"] as string;
    var themeCss = ViewData["ThemeCss"] as string;
    var themeKey = ViewData["ThemeKey"] as string;
}
<!doctype html>
<html lang="@(ViewData["ContentLanguageCode"] as string ?? "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @if (ViewData["Description"] is string description && !string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    @if (ViewData["Keywords"] is string keywords && !string.IsNullOrWhiteSpace(keywords))
    {
        <meta name="keywords" content="@keywords" />
    }
    @if (ViewData["CanonicalUrl"] is string canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    @if (ViewData["AlternateLanguages"] is IReadOnlyDictionary<string, string> alternateLanguages)
    {
        foreach (var alternate in alternateLanguages)
        {
            <link rel="alternate" hreflang="@alternate.Key" href="@alternate.Value" />
        }
        <link rel="alternate" hreflang="x-default" href="@ViewData["DefaultLanguageUrl"]" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    @if (ViewData["Description"] is string ogDescription && !string.IsNullOrWhiteSpace(ogDescription))
    {
        <meta property="og:description" content="@ogDescription" />
    }
    @if (ViewData["SharingImageUrl"] is string sharingImageUrl)
    {
        <meta property="og:image" content="@sharingImageUrl" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    @if (ViewData["FaviconUrl"] is string faviconUrl) { <link rel="icon" href="@faviconUrl" /> }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
    @if (!string.IsNullOrEmpty(inlineTemplateCss))
    {
        <style data-template-styles="inline">@Html.Raw(inlineTemplateCss)</style>
    }
    else if (templateStylesheet is not null &&
        templateStylesheet.StartsWith("~/css/bundles/", StringComparison.Ordinal))
    {
        <link rel="stylesheet" href="@templateStylesheet" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    }
    @if (!string.IsNullOrWhiteSpace(themeCss))
    {
        <style data-color-theme="@themeKey">@Html.Raw(themeCss)</style>
    }
    <link rel="stylesheet" href="~/css/popup.css" asp-append-version="true" />
    @if (ViewData["GtmContainerId"] is string gtmId)
    {
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','@gtmId');</script>
    }
</head>
<body class="@bodyClass">
@if (ViewData["GtmContainerId"] is string bodyGtmId)
{
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@bodyGtmId" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
}
@RenderBody()
<script src="~/js/site.js" asp-append-version="true" defer></script>
<script src="~/js/popup.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
