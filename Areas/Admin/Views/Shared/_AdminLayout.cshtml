<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] — Landing CMS</title><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"></head><body><aside><a class="admin-brand" href="/admin">Landing<span>CMS</span></a><nav><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan</a><a asp-area="Admin" asp-controller="Sections" asp-action="Index">Nội dung landing page</a>@if(User.IsInRole("SuperAdministrator") || User.IsInRole("Administrator")){<a asp-area="Admin" asp-controller="Settings" asp-action="Index">Cấu hình website</a><a asp-area="Admin" asp-controller="Users" asp-action="Index">Tài khoản & phân quyền</a>}<a href="/" target="_blank">Xem website ↗</a></nav><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Đăng xuất</button></form></aside><div class="admin-main"><header><button class="sidebar-toggle">☰</button><span>@User.Identity?.Name</span></header><main>@if(TempData["Message"] is string message){<div class="alert">@message</div>}@RenderBody()</main></div><script src="~/js/admin.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>
