@model DashboardViewModel
@{ ViewData["Title"] = "Tổng quan"; }
<div class="page-title"><div><h1>Tổng quan</h1><p>Template đang sử dụng: <strong>@Model.TemplateName</strong></p></div><a class="button" href="/" target="_blank">Xem website ↗</a></div>
<div class="metrics"><article><span>Tổng số section</span><strong>@Model.Sections.Count</strong></article><article><span>Đang hiển thị</span><strong>@Model.Sections.Count(x=>x.Slot.IsEnabled)</strong></article><article><span>Đang ẩn</span><strong>@Model.Sections.Count(x=>!x.Slot.IsEnabled)</strong></article></div>
<section class="panel"><div class="panel-head"><div><h2>Nội dung landing page</h2><p>Sắp xếp theo cấu hình của template.</p></div><a class="button button-secondary" asp-controller="Sections" asp-action="Index">Quản lý nội dung</a></div><div class="section-list">@foreach(var item in Model.Sections){<a asp-controller="Sections" asp-action="Edit" asp-route-id="@item.Slot.Id"><span class="order">@item.Slot.SortOrder</span><div><strong>@item.Slot.DisplayName</strong><small>@item.Slot.SectionDefinition.SectionType · #@item.Slot.SectionKey</small></div><span class="status @(item.Slot.IsEnabled?"on":"off")">@(item.Slot.IsEnabled?"Đang hiện":"Đang ẩn")</span><b>›</b></a>}</div></section>
