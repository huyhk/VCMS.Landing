@model IReadOnlyList<LandingSection>
@{ ViewData["Title"] = "Tổng quan"; }
<div class="page-title"><div><h1>Tổng quan</h1><p>Quản lý landing page từ một nơi duy nhất.</p></div><a class="button" href="/" target="_blank">Xem website ↗</a></div><div class="metrics"><article><span>Tổng số section</span><strong>@Model.Count</strong></article><article><span>Đang hiển thị</span><strong>@Model.Count(x=>x.IsPublished)</strong></article><article><span>Đang ẩn</span><strong>@Model.Count(x=>!x.IsPublished)</strong></article></div><section class="panel"><div class="panel-head"><div><h2>Nội dung landing page</h2><p>Sắp xếp theo thứ tự hiển thị hiện tại.</p></div><a class="button button-secondary" asp-controller="Sections" asp-action="Create">Thêm section</a></div><div class="section-list">@foreach(var item in Model){<a asp-controller="Sections" asp-action="Edit" asp-route-id="@item.Id"><span class="order">@item.SortOrder</span><div><strong>@item.Title</strong><small>@item.SectionType · #@item.SectionKey</small></div><span class="status @(item.IsPublished?"on":"off")">@(item.IsPublished?"Đang hiện":"Đang ẩn")</span><b>›</b></a>}</div></section>
