@model ContactSubmission
@{ ViewData["Title"] = "Chi tiết liên hệ"; }
<div class="page-title"><div><h1>@Model.Name</h1><p>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><a class="button button-secondary" asp-action="Index">Quay lại</a></div><section class="panel form-panel"><div class="form-grid"><div><label>Email</label><p><a href="mailto:@Model.Email">@Model.Email</a></p></div><div><label>Điện thoại</label><p>@Model.Phone</p></div><div class="full"><label>Nội dung</label><p style="white-space:pre-wrap">@Model.Message</p></div><div><label>Trạng thái email</label><p>@Model.Status</p></div>@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="full"><label>Lỗi gửi email</label><p class="validation">@Model.ErrorMessage</p></div>}</div></section>
