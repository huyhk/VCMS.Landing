@model SectionItemEditViewModel
@{ ViewData["Title"] = (Model.Id.HasValue ? "Chỉnh sửa mục — " : "Thêm mục — ") + Model.DisplayName; }
<div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Nội dung hiển thị theo schema do Developer định nghĩa.</p></div><a class="button button-secondary" asp-action="Items" asp-route-id="@Model.TemplateSectionId">Quay lại</a></div>
<form asp-action="SaveItem" method="post" enctype="multipart/form-data" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <input asp-for="Id" type="hidden"><input asp-for="TemplateSectionId" type="hidden">
    <div class="form-grid">
    @foreach(var field in Model.Fields)
    {
        Model.Values.TryGetValue(field.Key, out var value);
        if(field.Value.Editor == "image")
        {
            <div class="full"><label for="MediaFile">@field.Value.Label</label>@if(Model.MediaAsset is not null){<div class="single-image-preview"><img src="@Model.MediaAsset.RelativeUrl" alt=""><span>Ảnh hiện tại</span></div>}<input asp-for="MediaFile" type="file" accept="image/png,image/jpeg,image/webp" data-image-preview="item-image-preview"><div id="item-image-preview" class="single-image-preview"></div><span asp-validation-for="MediaFile"></span></div>
        }
        else if(field.Value.Editor == "html")
        {
            Model.AllowedHtmlTags.TryGetValue(field.Key, out var allowedTags);
            <div class="full"><label>@field.Value.Label</label><div class="html-editor" data-html-editor><div class="html-editor-toolbar" role="toolbar" aria-label="Định dạng nội dung">@if(allowedTags?.Contains("strong")==true){<button type="button" data-command="bold"><strong>B</strong></button>}@if(allowedTags?.Contains("em")==true){<button type="button" data-command="italic"><em>I</em></button>}@if(allowedTags?.Contains("ul")==true){<button type="button" data-command="insertUnorderedList">• List</button>}@if(allowedTags?.Contains("a")==true){<button type="button" data-link>Link</button>}<button type="button" data-command="removeFormat">Xóa định dạng</button></div><div class="html-editor-content" contenteditable="true">@Html.Raw(value)</div><textarea name="Values[@field.Key]" hidden data-html-editor-value>@value</textarea></div><span class="field-validation-error">@Html.ValidationMessage($"Values[{field.Key}]")</span></div>
        }
        else if(field.Value.Editor == "textarea")
        {
            <div class="full"><label for="item-@field.Key">@field.Value.Label</label><textarea id="item-@field.Key" name="Values[@field.Key]" rows="5">@value</textarea><span class="field-validation-error">@Html.ValidationMessage($"Values[{field.Key}]")</span></div>
        }
        else
        {
            <div class="full"><label for="item-@field.Key">@field.Value.Label</label><input id="item-@field.Key" name="Values[@field.Key]" value="@value" type="@(field.Value.Editor == "media-url" ? "url" : "text")" placeholder="@(field.Value.Editor == "media-url" ? "https://www.youtube.com/watch?v=..." : null)"><span class="field-validation-error">@Html.ValidationMessage($"Values[{field.Key}]")</span></div>
        }
    }
        <div class="check-row full"><label><input asp-for="IsEnabled"> Hiển thị mục này</label></div>
    </div>
    <div class="form-actions"><button class="button" type="submit">Lưu mục nội dung</button></div>
</form>
