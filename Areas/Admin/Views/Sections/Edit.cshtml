@model SectionContentEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa " + Model.DisplayName;
    var currentLanguageName = Model.Languages.FirstOrDefault(x => x.Code == Model.LanguageCode)?.Name ?? Model.LanguageCode;
}
<div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Section <strong>#@Model.SectionKey</strong> · @Model.SectionType</p></div><div class="page-actions">@if(Model.IsDefaultLanguage){<a class="button button-secondary" asp-action="History" asp-route-id="@Model.TemplateSectionId">Lịch sử phiên bản</a>}<a class="button button-secondary" asp-action="Index">Quay lại</a></div></div>
<div class="panel language-content-bar"><strong>Nội dung đang chỉnh sửa:</strong>@foreach(var language in Model.Languages){<a class="button @(language.Code == Model.LanguageCode ? "" : "button-secondary")" asp-action="Edit" asp-route-id="@Model.TemplateSectionId" asp-route-language="@language.Code">@language.Name</a>}@if(!Model.IsDefaultLanguage && !Model.HasTranslation){<span class="status off">Đang hiển thị nội dung tiếng Việt để làm mẫu</span>}</div>
<form asp-action="Save" method="post" enctype="multipart/form-data" class="panel form-panel">
    <div asp-validation-summary="All" class="validation"></div>
    <input asp-for="LanguageCode" type="hidden"><input asp-for="TemplateSectionId" type="hidden"><input asp-for="ContentId" type="hidden"><input asp-for="SectionKey" type="hidden"><input asp-for="SectionType" type="hidden"><input asp-for="DisplayName" type="hidden">
    <div class="form-grid">
        <div class="full"><label asp-for="Eyebrow">Nhãn nhỏ</label><input asp-for="Eyebrow"></div>
        <div class="full"><label asp-for="Title">Tiêu đề</label><input asp-for="Title"><span asp-validation-for="Title"></span></div>
        <div class="full"><label asp-for="Subtitle">Mô tả ngắn</label><textarea asp-for="Subtitle" rows="2"></textarea></div>
        <div class="full">
            <label asp-for="NavigationLabel">Nhãn trên menu (@currentLanguageName)</label>
            <input asp-for="NavigationLabel" maxlength="50"><span asp-validation-for="NavigationLabel"></span>
            <small>
                Nhãn ngắn hiển thị trên menu của ngôn ngữ đang chỉnh sửa.
                @if (!Model.ShowInNavigation)
                {
                    <span>Section hiện chưa được bật xuất hiện trên menu; giá trị này vẫn được lưu để dùng khi bật.</span>
                }
            </small>
        </div>
        @if(Model.ContentEditor == "html")
        {
            <div class="full">
                <label asp-for="Content">Nội dung</label>
                <div class="html-editor" data-html-editor>
                    <div class="html-editor-toolbar" role="toolbar" aria-label="Định dạng nội dung">
                        @if(Model.AllowedHtmlTags.Contains("strong")){<button type="button" data-command="bold"><strong>B</strong></button>}@if(Model.AllowedHtmlTags.Contains("em")){<button type="button" data-command="italic"><em>I</em></button>}@if(Model.AllowedHtmlTags.Contains("u")){<button type="button" data-command="underline"><u>U</u></button>}
                        @if(Model.AllowedHtmlTags.Contains("h2")){<button type="button" data-block="h2">H2</button>}@if(Model.AllowedHtmlTags.Contains("h3")){<button type="button" data-block="h3">H3</button>}
                        @if(Model.AllowedHtmlTags.Contains("ul")){<button type="button" data-command="insertUnorderedList">• List</button>}@if(Model.AllowedHtmlTags.Contains("ol")){<button type="button" data-command="insertOrderedList">1. List</button>}
                        @if(Model.AllowedHtmlTags.Contains("a")){<button type="button" data-link>Link</button>}<button type="button" data-command="removeFormat">Xóa định dạng</button>
                    </div>
                    <div class="html-editor-content" contenteditable="true">@Html.Raw(Model.Content)</div>
                    <textarea asp-for="Content" hidden data-html-editor-value></textarea>
                </div>
                <small>Cho phép tiêu đề, đoạn văn, định dạng chữ, danh sách và liên kết.</small>
            </div>
        }
        else
        {
            <div class="full"><label asp-for="Content">Nội dung</label><textarea asp-for="Content" rows="7"></textarea><small>Cards/Stats: mỗi dòng là một mục, phân cách tiêu đề và mô tả bằng ký tự |</small></div>
        }
        <div class="full"><label>Ảnh chính của section (@currentLanguageName)</label><div id="section-image-preview" class="single-image-preview">@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img src="@Model.ImageUrl" alt=""><span>Ảnh hiện tại</span>}</div><input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" data-image-preview="section-image-preview"><small>Tự tối ưu tối đa 1400 × 1400 px. @if(Model.UsesFallbackMedia){<span>Đang dùng ảnh của ngôn ngữ mặc định; upload để thay bằng ảnh riêng.</span>}</small></div>
        <div class="full"><label asp-for="ImageUrl">URL hình ảnh (@currentLanguageName)</label><input asp-for="ImageUrl"></div>
        @if(Model.SectionType == "Hero")
        {
            <div class="full"><label>Background Hero (@currentLanguageName)</label><input asp-for="BackgroundFiles" type="file" accept="image/png,image/jpeg,image/webp" multiple data-images-preview="hero-background-preview"><small>Chọn nhiều ảnh; tự tối ưu tối đa 1920 × 1200 px. Nếu chưa upload bản riêng, website dùng ảnh ngôn ngữ mặc định.</small><div id="hero-background-preview" class="media-thumbs upload-selection-preview"></div></div>
            @if(Model.Backgrounds.Count > 0)
            {
                <div class="full media-thumbs">@foreach(var media in Model.Backgrounds){<article><img src="@media.MediaAsset.RelativeUrl" alt=""><span>Thứ tự @media.SortOrder</span>@if(Model.IsDefaultLanguage || media.LanguageCode == Model.LanguageCode){<button class="danger-link" type="submit" formaction="@Url.Action("DeleteBackground",new{id=media.Id})" onclick="return confirm('Gỡ ảnh này khỏi Hero?')">Gỡ ảnh</button>}else{<small>Ảnh từ ngôn ngữ mặc định</small>}</article>}</div>
            }
        }
        @if(Model.SectionType == "Gallery")
        {
            <div class="full"><label>Hình ảnh trong thư viện (@currentLanguageName)</label><input asp-for="GalleryFiles" type="file" accept="image/png,image/jpeg,image/webp" multiple data-images-preview="gallery-image-preview"><small>Có thể chọn nhiều ảnh. Nếu chưa có bản riêng, website dùng gallery ngôn ngữ mặc định.</small><div id="gallery-image-preview" class="media-thumbs upload-selection-preview"></div></div>
            @if(Model.GalleryImages.Count > 0)
            {
                <div class="full media-thumbs">@foreach(var media in Model.GalleryImages){<article><img src="@media.MediaAsset.RelativeUrl" alt=""><span>Thứ tự @media.SortOrder</span>@if(Model.IsDefaultLanguage || media.LanguageCode == Model.LanguageCode){<button class="danger-link" type="submit" formaction="@Url.Action("DeleteGalleryImage",new{id=media.Id})" onclick="return confirm('Gỡ ảnh này khỏi thư viện?')">Gỡ ảnh</button>}else{<small>Ảnh từ ngôn ngữ mặc định</small>}</article>}</div>
            }
        }
        @if(Model.SectionType == "Content")
        {
            <div><label asp-for="BadgeValue">Số liệu nổi bật</label><input asp-for="BadgeValue" maxlength="30" placeholder="Ví dụ: 8+"><span asp-validation-for="BadgeValue"></span></div>
            <div><label asp-for="BadgeLabel">Nhãn số liệu</label><input asp-for="BadgeLabel" maxlength="100" placeholder="Ví dụ: năm kinh nghiệm"><span asp-validation-for="BadgeLabel"></span></div>
            <div class="full"><small>Để trống cả hai trường nếu không muốn hiển thị badge.</small></div>
        }
        @if(Model.SectionType == "Hero")
        {
            <div><label asp-for="BadgeLabel">Nhãn số liệu Hero</label><input asp-for="BadgeLabel" maxlength="100" placeholder="Ví dụ: Tăng trưởng bền vững"><span asp-validation-for="BadgeLabel"></span></div>
            <div><label asp-for="BadgeValue">Giá trị số liệu Hero</label><input asp-for="BadgeValue" maxlength="30" placeholder="Ví dụ: +42%"><span asp-validation-for="BadgeValue"></span></div>
            <div class="full"><label asp-for="HighlightLabel">Nhãn nổi bật Hero</label><input asp-for="HighlightLabel" maxlength="100" placeholder="Ví dụ: Thiết kế có mục tiêu"><span asp-validation-for="HighlightLabel"></span><small>Để trống cả ba trường nếu không muốn hiển thị khối minh họa số liệu.</small></div>
        }
        <div><label asp-for="PrimaryButtonText">Nút chính</label><input asp-for="PrimaryButtonText"></div><div><label asp-for="PrimaryButtonUrl">Liên kết nút chính</label><input asp-for="PrimaryButtonUrl"></div>
        <div><label asp-for="SecondaryButtonText">Nút phụ</label><input asp-for="SecondaryButtonText"></div><div><label asp-for="SecondaryButtonUrl">Liên kết nút phụ</label><input asp-for="SecondaryButtonUrl"></div>
        @if(Model.IsDefaultLanguage && User.IsInRole("SuperAdministrator"))
        {
            <div class="check-row"><label><input asp-for="IsEnabled"> Hiển thị section trong template đang sử dụng</label><span asp-validation-for="IsEnabled"></span></div>
        }
        else
        {
            <div class="check-row"><label>Trạng thái: @(Model.IsEnabled ? "Đang hiển thị" : "Đang ẩn")</label></div>
        }
    </div>
    <div class="form-actions"><button class="button" type="submit">Lưu thay đổi</button></div>
</form>
@if(Model.HasItems)
{
    <section class="panel repeater-callout"><div><h2>Danh sách nội dung</h2><p>Thêm, chỉnh sửa và sắp xếp các mục con của section này.</p></div><a class="button button-secondary" asp-action="Items" asp-route-id="@Model.TemplateSectionId" asp-route-language="@Model.LanguageCode">Quản lý danh sách</a></section>
}
