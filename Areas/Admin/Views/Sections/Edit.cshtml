@model LandingSection
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm section" : "Chỉnh sửa section"; }
<div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Mọi thay đổi có hiệu lực ngay sau khi lưu.</p></div><a class="button button-secondary" asp-action="Index">Quay lại</a></div><form asp-action="Save" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden"><div class="form-grid"><div><label asp-for="SectionKey">Mã section</label><input asp-for="SectionKey"><span asp-validation-for="SectionKey"></span><small>Dùng làm liên kết, ví dụ: services</small></div><div><label asp-for="SectionType">Kiểu hiển thị</label><select asp-for="SectionType"><option>Hero</option><option>Cards</option><option>Content</option><option>Stats</option><option>Cta</option></select></div><div class="full"><label asp-for="Eyebrow">Nhãn nhỏ</label><input asp-for="Eyebrow"></div><div class="full"><label asp-for="Title">Tiêu đề</label><input asp-for="Title"><span asp-validation-for="Title"></span></div><div class="full"><label asp-for="Subtitle">Mô tả ngắn</label><textarea asp-for="Subtitle" rows="2"></textarea></div><div class="full"><label asp-for="Content">Nội dung</label><textarea asp-for="Content" rows="7"></textarea><small>Cards/Stats: mỗi dòng là một mục, phân cách tiêu đề và mô tả bằng ký tự |</small></div><div class="full"><label asp-for="ImageUrl">URL hình ảnh</label><input asp-for="ImageUrl"></div><div><label asp-for="PrimaryButtonText">Nút chính</label><input asp-for="PrimaryButtonText"></div><div><label asp-for="PrimaryButtonUrl">Liên kết nút chính</label><input asp-for="PrimaryButtonUrl"></div><div><label asp-for="SecondaryButtonText">Nút phụ</label><input asp-for="SecondaryButtonText"></div><div><label asp-for="SecondaryButtonUrl">Liên kết nút phụ</label><input asp-for="SecondaryButtonUrl"></div><div><label asp-for="SortOrder">Thứ tự</label><input asp-for="SortOrder" type="number"></div><div class="check-row"><label><input asp-for="IsPublished"> Hiển thị section này</label></div></div><div class="form-actions"><button class="button" type="submit">Lưu thay đổi</button>@if(Model.Id>0 && User.IsInRole("Administrator")){<button class="danger-link" type="submit" formaction="@Url.Action("Delete",new{id=Model.Id})" onclick="return confirm('Xóa section này?')">Xóa section</button>}</div></form>
