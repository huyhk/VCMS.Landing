@model IReadOnlyList<SectionListItemViewModel>
@{ ViewData["Title"] = "Nội dung landing page"; }
<div class="page-title"><div><h1>Nội dung landing page</h1><p>Template đang sử dụng: <strong>@ViewBag.TemplateName</strong>. Chỉ các section thuộc template này được hiển thị.</p></div></div>
<section class="panel"><table><thead><tr><th>Thứ tự</th><th>Section</th><th>Loại</th><th>Yêu cầu</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Slot.SortOrder</td><td><strong>@item.Slot.DisplayName</strong><small>#@item.Slot.SectionKey</small></td><td>@item.Slot.SectionDefinition.SectionType</td><td>@(item.Slot.IsRequired ? "Bắt buộc" : "Tùy chọn")</td><td><span class="status @(item.Slot.IsEnabled?"on":"off")">@(item.Slot.IsEnabled?"Đang hiện":"Đang ẩn")</span></td><td><a asp-action="Edit" asp-route-id="@item.Slot.Id">Chỉnh sửa</a></td></tr>}</tbody></table></section>
