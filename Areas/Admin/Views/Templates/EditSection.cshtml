@model TemplateSectionComposerViewModel
@{ ViewData["Title"] = "Thiết lập section"; }
<div class="page-title"><div><h1>Thiết lập section</h1><p>@Model.DefinitionName</p></div><a class="button button-secondary" asp-action="Sections" asp-route-id="@Model.TemplateId">Quay lại</a></div>
<form asp-action="EditSection" method="post" class="panel form-panel composer-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden"><input asp-for="TemplateId" type="hidden"><input asp-for="SectionDefinitionId" type="hidden"><div class="form-grid"><div class="full"><label asp-for="DisplayName">Tên quản trị</label><input asp-for="DisplayName"><span asp-validation-for="DisplayName"></span></div>@if(Model.LayoutOptions.Count>0){<div class="full"><label asp-for="Layout">Cách hiển thị</label><select asp-for="Layout">@foreach(var option in Model.LayoutOptions){<option value="@option.Value">@option.Label</option>}</select><span asp-validation-for="Layout"></span></div>}<div class="check-row"><label><input asp-for="IsEnabled"> Hiển thị trong template</label></div></div><div class="form-actions"><button class="button" type="submit">Lưu thiết lập</button></div></form>
