@model TemplateSectionComposerViewModel
@{ ViewData["Title"] = "Thêm section"; }
<div class="page-title"><div><h1>Thêm section có sẵn</h1><p>Chọn section từ thư viện; nội dung vẫn được dùng chung nếu section xuất hiện ở nhiều template.</p></div><div><a class="button button-secondary" asp-action="Sections" asp-route-id="@Model.TemplateId">Quay lại</a> <a class="button button-secondary" asp-controller="SectionLibrary" asp-action="Create">Tạo section mới</a></div></div>
<form method="get" asp-action="CreateSection" class="panel form-panel definition-picker"><input type="hidden" name="templateId" value="@Model.TemplateId"><label>Section trong thư viện</label><select name="pageSectionId" onchange="this.form.submit()">@foreach(var pageSection in Model.PageSections){<option value="@pageSection.Id" selected="@(pageSection.Id==Model.PageSectionId)">@pageSection.DisplayName — @pageSection.SectionDefinition.SectionType</option>}</select></form>
<form asp-action="CreateSection" method="post" class="panel form-panel composer-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="TemplateId" type="hidden"><input asp-for="PageSectionId" type="hidden"><input asp-for="SectionDefinitionId" type="hidden"><div class="form-grid"><div class="full"><label asp-for="DisplayName">Tên hiển thị trong template</label><input asp-for="DisplayName"><span asp-validation-for="DisplayName"></span></div>@if(Model.LayoutOptions.Count>0){<div class="full"><label asp-for="Layout">Cách hiển thị</label><select asp-for="Layout">@foreach(var option in Model.LayoutOptions){<option value="@option.Value">@option.Label</option>}</select><span asp-validation-for="Layout"></span></div>}<div class="check-row"><label><input asp-for="IsEnabled"> Hiển thị ngay sau khi thêm</label></div>@if(Model.NavigationAllowed){<div class="check-row"><label><input asp-for="ShowInNavigation"> Hiển thị trên menu</label></div><div class="full"><label asp-for="NavigationLabel">Nhãn trên menu</label><input asp-for="NavigationLabel" placeholder="Để trống sẽ dùng tên hiển thị"><span asp-validation-for="NavigationLabel"></span></div>}</div><div class="form-actions"><button class="button" type="submit">Thêm vào template</button></div></form>
