@model TemplateSectionComposerViewModel
@{ ViewData["Title"] = "Thêm section"; }
<div class="page-title"><div><h1>Thêm section</h1><p>Chọn khối do Developer đã định nghĩa.</p></div><a class="button button-secondary" asp-action="Sections" asp-route-id="@Model.TemplateId">Quay lại</a></div>
<form method="get" asp-action="CreateSection" class="panel form-panel definition-picker"><input type="hidden" name="templateId" value="@Model.TemplateId"><label>Section definition</label><select name="definitionId" onchange="this.form.submit()">@foreach(var definition in Model.Definitions){<option value="@definition.Id" selected="@(definition.Id==Model.SectionDefinitionId)">@definition.Name — @definition.SectionType</option>}</select></form>
<form asp-action="CreateSection" method="post" class="panel form-panel composer-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="TemplateId" type="hidden"><input asp-for="SectionDefinitionId" type="hidden"><div class="form-grid"><div class="full"><label asp-for="DisplayName">Tên quản trị</label><input asp-for="DisplayName"><span asp-validation-for="DisplayName"></span></div>@if(Model.LayoutOptions.Count>0){<div class="full"><label asp-for="Layout">Cách hiển thị</label><select asp-for="Layout">@foreach(var option in Model.LayoutOptions){<option value="@option.Value">@option.Label</option>}</select><span asp-validation-for="Layout"></span></div>}<div class="check-row"><label><input asp-for="IsEnabled"> Hiển thị ngay sau khi tạo</label></div>@if(Model.NavigationAllowed){<div class="check-row"><label><input asp-for="ShowInNavigation"> Hiển thị trên menu</label></div><div class="full"><label asp-for="NavigationLabel">Nhãn trên menu</label><input asp-for="NavigationLabel" placeholder="Để trống sẽ dùng tên quản trị"><span asp-validation-for="NavigationLabel"></span><small>Tối đa 50 ký tự; có thể khác tiêu đề hiển thị trong section.</small></div>}</div><div class="form-actions"><button class="button" type="submit">Thêm section</button></div></form>
