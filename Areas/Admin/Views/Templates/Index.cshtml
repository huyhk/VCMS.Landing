@model IReadOnlyList<TemplateListItemViewModel>
@{ ViewData["Title"] = "Giao diện"; }
<div class="page-title"><div><h1>Giao diện trang chủ</h1><p>Chỉ Super Administrator có quyền thay đổi template đang sử dụng.</p></div></div>
<div class="template-grid">@foreach(var item in Model){<article class="template-card @(item.IsActive?"active":"")"><div class="template-preview">@if(!string.IsNullOrWhiteSpace(item.Template.PreviewImageUrl)){<img src="@item.Template.PreviewImageUrl" alt="@item.Template.Name">}else{<span>@item.Template.Name</span>}</div><div class="template-info"><div><h2>@item.Template.Name</h2><p>@item.Template.Description</p><small>Phiên bản @item.Template.Version · @item.SectionCount section</small></div>@if(item.IsActive){<span class="status on">Đang sử dụng</span>}else{<form asp-action="Activate" method="post" onsubmit="return confirm('Áp dụng template này cho trang chủ?')"><input type="hidden" name="id" value="@item.Template.Id"><button class="button" type="submit">Áp dụng</button></form>}</div></article>}</div>
