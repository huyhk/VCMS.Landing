@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="page-title"><div><h1>Đặt lại mật khẩu</h1><p>Tài khoản <strong>@Model.UserName</strong> · @Model.DisplayName</p></div><a class="button button-secondary" asp-action="Index">Quay lại</a></div><form asp-action="ResetPassword" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="UserId" type="hidden"><input asp-for="UserName" type="hidden"><input asp-for="DisplayName" type="hidden"><div class="form-grid"><div><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" autocomplete="new-password"><span asp-validation-for="NewPassword"></span></div><div><label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password"><span asp-validation-for="ConfirmPassword"></span></div></div><p>Mật khẩu phải có ít nhất 10 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p><div class="form-actions"><button class="button" type="submit">Đặt lại mật khẩu</button></div></form>
