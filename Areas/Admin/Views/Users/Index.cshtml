@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = "Tài khoản & phân quyền"; }
<div class="page-title"><div><h1>Tài khoản & phân quyền</h1><p>Administrator quản lý toàn bộ; Editor chỉ quản lý nội dung.</p></div><a class="button" asp-action="Create">+ Thêm tài khoản</a></div><section class="panel"><table><thead><tr><th>Người dùng</th><th>Email</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.DisplayName</strong></td><td>@item.Email</td><td><span class="status @(item.IsActive?"on":"off")">@(item.IsActive?"Hoạt động":"Đã khóa")</span></td><td><a asp-action="Edit" asp-route-id="@item.Id">Chỉnh sửa</a></td></tr>}</tbody></table></section>
