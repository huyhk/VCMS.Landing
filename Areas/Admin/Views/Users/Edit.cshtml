@model UserEditViewModel
@{ ViewData["Title"] = Model.Id is null ? "Thêm tài khoản" : "Chỉnh sửa tài khoản"; }
<div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Thiết lập thông tin và quyền truy cập.</p></div><a class="button button-secondary" asp-action="Index">Quay lại</a></div><form asp-action="Save" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden"><div class="form-grid"><div><label asp-for="DisplayName">Tên hiển thị</label><input asp-for="DisplayName"></div><div><label asp-for="Email">Email đăng nhập</label><input asp-for="Email"></div><div><label asp-for="Role">Vai trò</label><select asp-for="Role"><option value="Editor">Editor — quản lý nội dung</option><option value="Administrator">Administrator — toàn quyền</option></select></div><div><label asp-for="Password">Mật khẩu @(Model.Id is null?"":"mới (để trống nếu giữ nguyên)")</label><input asp-for="Password"></div><div class="check-row"><label><input asp-for="IsActive"> Tài khoản hoạt động</label></div></div><div class="form-actions"><button class="button" type="submit">Lưu tài khoản</button></div></form>
