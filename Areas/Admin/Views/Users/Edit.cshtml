@model UserEditViewModel
@{ ViewData["Title"] = Model.Id is null ? "Thêm tài khoản" : "Chỉnh sửa tài khoản"; }
<div class="page-title"><div><h1>@ViewData["Title"]</h1><p>Thiết lập thông tin và quyền truy cập.</p></div><div>@if(Model.Id is not null && Model.Role != "SuperAdministrator" && (User.IsInRole("SuperAdministrator") || (User.IsInRole("Administrator") && Model.Role == "Editor"))){<a class="button button-secondary" asp-action="ResetPassword" asp-route-id="@Model.Id">Đặt lại mật khẩu</a>} <a class="button button-secondary" asp-action="Index">Quay lại</a></div></div>
<form asp-action="Save" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden"><div class="form-grid"><div><label asp-for="DisplayName">Tên hiển thị</label><input asp-for="DisplayName"></div><div><label asp-for="UserName">Tên đăng nhập</label><input asp-for="UserName" autocomplete="off"><span asp-validation-for="UserName"></span></div><div><label asp-for="Email">Email (không bắt buộc)</label><input asp-for="Email"><span asp-validation-for="Email"></span></div><div><label asp-for="Role">Vai trò</label><select asp-for="Role"><option value="Editor">Editor — quản lý nội dung</option><option value="Administrator">Administrator — quản trị website</option>@if(User.IsInRole("SuperAdministrator")){<option value="SuperAdministrator">Super Administrator — quản trị hệ thống</option>}</select></div>@if(Model.Id is null){<div><label asp-for="Password">Mật khẩu ban đầu</label><input asp-for="Password" autocomplete="new-password"><span asp-validation-for="Password"></span></div>}<div class="check-row"><label><input asp-for="IsActive"> Tài khoản hoạt động</label></div></div><div class="form-actions"><button class="button" type="submit">Lưu tài khoản</button></div></form>
