@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<div class="page-title">
    <div>
        <h1>Đổi mật khẩu</h1>
        <p>Cập nhật mật khẩu của tài khoản đang đăng nhập.</p>
    </div>
</div>

<form asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" method="post" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="form-grid">
        <div class="full">
            <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" autocomplete="current-password">
            <span asp-validation-for="CurrentPassword"></span>
        </div>
        <div class="full">
            <label asp-for="NewPassword">Mật khẩu mới</label>
            <input asp-for="NewPassword" autocomplete="new-password">
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="full">
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>
    <p class="form-hint">Mật khẩu tối thiểu 10 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
    <div class="form-actions">
        <button class="button" type="submit">Đổi mật khẩu</button>
        <a class="button button-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Hủy</a>
    </div>
</form>
